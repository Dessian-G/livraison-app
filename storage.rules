rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/utilisateurs/$(request.auth.uid)).data.role == 'admin';
    }

    // Images produits et logo : lecture publique, écriture admin uniquement.
    // Avant : "if request.auth != null" acceptait aussi les comptes livreur (et tout
    // compte auto-créé via la faille utilisateurs/{uid} corrigée dans firestore.rules).
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
